# Database Configuration
POSTGRES_DB=leaseflow
POSTGRES_USER=leaseflow
POSTGRES_PASSWORD=leaseflow_secret_pw
DB_PORT=5432

# Application Configuration
APP_PORT=8085
SPRING_PROFILES_ACTIVE=dev

# Security & JWT (Must be at least 256 bits long for HS256)
JWT_SECRET=ThisIsAVeryLongSecretKeyForLeaseFlowApplicationThatMustBeAtLeast256BitsLong
JWT_EXPIRATION_MS=86400000

# CORS (Comma-separated origins, leave empty for same-origin only)
CORS_ALLOWED_ORIGINS=

